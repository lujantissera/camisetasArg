PORT=3001
FRONTEND_URL=http://localhost:5173

# Turso — dejar vacío en desarrollo local (usa un archivo SQLite en ../data/shop.db automáticamente).
# En producción: turso.tech > tu base > "Create token" para obtener ambos valores.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Auth0 — Create an API at dashboard.auth0.com > Applications > APIs
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://camisetas-arg-api

# Stripe — Get from dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Secreto compartido para POST /api/admin/scrape (dispara el catálogo on-demand).
# Generar cualquier string largo random y ponerlo también como secret en GitHub Actions.
SCRAPE_SECRET=
